# Worker env. Copy to worker/.env. NEVER commit real values. --mock needs none of these.

# LiveKit (transport / SFU) - needed for the 5b transport phase + token server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT: LiveKit Inference by default (no key). For reliability when Inference rate-limits (429),
# add a free Deepgram key and set SAM_STT=deepgram.
DEEPGRAM_API_KEY=
SAM_STT=deepgram
SAM_STT_MODEL=deepgram/nova-3
SAM_STT_EOT_TIMEOUT_MS=500

# TTS: ElevenLabs (reuse the rm_api key). SAM_VOICE_ID = Samuel's signature voice.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
SAM_VOICE_ID=
SCHEDULE_VOICE_ID=
DESIGN_VOICE_ID=
SALES_VOICE_ID=

# Brain for the POC: OpenAI gpt-4o-mini directly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq (OpenAI-compatible, very low TTFT) - candidate live/low-tier brain for A/B.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
SAM_LLM_MAX_COMPLETION_TOKENS=256

# Hermes brain - OpenAI-compatible endpoint (this is "Charles"/ask_charles internally).
# Converge here later; leave blank for the POC.
HERMES_BASE_URL=
HERMES_API_KEY=

# Rainmaker command surface (read-only first)
RM_API_BASE_URL=https://rainmaker-api-waqs.onrender.com
RM_API_TOKEN=

# Wave 8 turn handling: cloud (auto v1/v1-mini) | mini | vad | stt.
SAM_TURN_MODE=stt
SAM_PREEMPTIVE_TTS=1
SAM_LATENCY_LOG=1

# Adaptive barge-in sensitivity. Backchannel suppression protects coughs/short acknowledgments.
SAM_INTERRUPTION_MODE=adaptive
SAM_INTERRUPT_MIN_DURATION=0.25
SAM_INTERRUPT_MIN_WORDS=1

# Endpointing: silence (sec) before Sam decides you're done and replies.
# Lower = snappier but may cut you off mid-thought; raise if he jumps in early.
SAM_ENDPOINTING_MIN=0.25
SAM_ENDPOINTING_MAX=0.6

# Owner-only LiveKit SIP pilot. Auth values are shared only with the TwiML Bin.
SAM_PHONE_STT_MODEL=deepgram/nova-2-phonecall
SAM_SIP_PILOT_NUMBER=
SAM_SIP_OWNER_NUMBERS=
SAM_SIP_AUTH_USERNAME=
SAM_SIP_AUTH_PASSWORD=

# Durable owner-only session memory. Point SAM_CACHE_DIR at a persistent disk in production.
SAM_MEMORY_ENABLED=1
SAM_CACHE_DIR=

# Token server
TOKEN_SERVER_PORT=8788
