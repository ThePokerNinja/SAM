# S.A.M. — top-level env reference.
# Each package has its own .env.example; copy those into client/.env and worker/.env.
# This file documents the full set of variables in one place. NEVER commit real values.

# ── LiveKit (transport / SFU) ───────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SAM_TURN_MODE=stt
SAM_PREEMPTIVE_TTS=1
SAM_INTERRUPTION_MODE=adaptive
SAM_LATENCY_LOG=1
SAM_MEMORY_ENABLED=1
SAM_CACHE_DIR=

# ── STT: Deepgram Nova-3 ────────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── TTS: ElevenLabs ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Persona voice ids (Samuel + sub-agents). Placeholders until selected/cloned.
SAM_VOICE_ID=
SCHEDULE_VOICE_ID=
DESIGN_VOICE_ID=
SALES_VOICE_ID=

# ── Brain: Hermes (OpenAI-compatible endpoint) ──────────────────────────────
HERMES_BASE_URL=
HERMES_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TPM_BUDGET=8000
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
SAM_PROMPT_TOOL_MODE=dynamic

# ── Rainmaker command surface (rm_api) ──────────────────────────────────────
RM_API_BASE_URL=https://rainmaker-api-waqs.onrender.com
RM_API_TOKEN=
SAM_PORTAL_GOOGLE_REQUIRED=0

# ── Client (Vite, must be VITE_-prefixed to reach the browser) ──────────────
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_TOKEN_SERVER_URL=http://localhost:8788
VITE_USE_MOCK=1
